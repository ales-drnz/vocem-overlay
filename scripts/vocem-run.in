#
# Runs a command with the OpenGL overlay preloaded.
#
#     vocem-run <command> [args...]
#     vocem-run minecraft-launcher
#     vocem-run %command%          # in a game's launch options
#
# Vulkan games need none of this: the layer is loaded by the Vulkan loader itself.
# OpenGL has no such mechanism, so the library has to be preloaded, and something
# has to do it.
#
# $LIB is expanded by the dynamic linker to the library directory of the process
# being started, so one value covers 32-bit and 64-bit games without knowing in
# advance which the command turns out to be.

set -eu

if [ "$#" -eq 0 ]; then
    echo "usage: vocem-run <command> [args...]" >&2
    exit 2
fi

# The shim, not the overlay itself: a small library with no C++ runtime behind it.
# It dlopens the real library RTLD_LOCAL on the first GL frame -- so a game that
# never draws pays almost nothing, and the overlay's bundled ImGui never enters the
# game's global symbol scope. This is the same file the session preloads through
# environment.d, at the same path, both taken from the install prefix: a difference
# would only show up in the games launched one way (tests/one_preload_path.cmake).
VOCEM_PRELOAD='@VOCEM_LIBDIR_TOKEN@/libvocem_gl_shim.so'

# First, not last: of two OpenGL interposers in one process only the one ahead
# can hand the frame on to the other. With the shim first, an interposer after
# it such as MangoHud is given every frame after us; with it last, MangoHud
# calls the driver itself and we never see a frame. So `mangohud vocem-run
# game` works as well as `vocem-run mangohud game` (tests/gl_beside_mangohud).
# A copy the session already put in LD_PRELOAD is harmless: ld.so maps a file
# once, at its first position.
if [ -n "${LD_PRELOAD:-}" ]; then
    LD_PRELOAD="${VOCEM_PRELOAD}:${LD_PRELOAD}"
else
    LD_PRELOAD="${VOCEM_PRELOAD}"
fi
export LD_PRELOAD

# Preloading a launcher is frequently the only way to reach the game it starts, so
# the interposer ignores processes listed in hidden_apps -- launchers included --
# and only draws in the game itself.
exec "$@"
