# Build trees
build/
build-*/
build32/
compile_commands.json
*.o
*.so
*.spv

# IDE / OS
.cache/
.idea/
.vscode/
*.user
.DS_Store

# makepkg works in the packaging directory and leaves its results there; the
# packages themselves are build output like any other.
packaging/pkg/
packaging/src/
packaging/*.pkg.tar.*
# A VCS source is cached as a bare clone named after it, beside the PKGBUILD.
packaging/vocem-overlay/
packaging/imgui/

# Python leaves these beside any script it IMPORTS rather than runs.
__pycache__/
*.pyc

# Fetched by scripts/make-fonts.py, which deletes them again; what is committed
# is the subsets it produces under common/fonts/.
third_party/fonts/*-Variable.ttf
# Two of the six are not named "-Variable". The script unlinks all six in a
# `finally`; these two lines are for a run killed before it gets there.
third_party/fonts/NotoSansMath-Regular.ttf
third_party/fonts/NotoSansSymbols2-Regular.ttf

# AI tooling
.claude/
CLAUDE.md
DESIGN.md
PROMPT-*.md
AUDIT-*.md

# flatpak-builder leaves its cache and its build trees beside the manifest.
.flatpak-builder/
# And the release build keeps its build directory and its exported repository
# there too, deliberately: all three have to be on one filesystem, and /tmp may
# be a tmpfs the builder's sandbox does not share. See flatpak/README.md.
vocem-flatpak-build/
vocem-flatpak-repo/
