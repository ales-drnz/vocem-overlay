#version 450
// ImGui's own vertex shader, verbatim (backends/imgui_impl_vulkan.cpp,
// glsl_shader.vert): the HDR pipeline replaces only the fragment stage, and
// the vertex interface must stay byte-identical to what RenderDrawData binds.

layout(location = 0) in vec2 aPos;
layout(location = 1) in vec2 aUV;
layout(location = 2) in vec4 aColor;
layout(push_constant) uniform uPushConstant { vec2 uScale; vec2 uTranslate; } pc;

out gl_PerVertex { vec4 gl_Position; };
layout(location = 0) out struct { vec4 Color; vec2 UV; } Out;

void main()
{
    Out.Color = aColor;
    Out.UV = aUV;
    gl_Position = vec4(aPos * pc.uScale + pc.uTranslate, 0, 1);
}
