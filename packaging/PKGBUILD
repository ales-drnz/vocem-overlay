#
# Builds twice: 64-bit with the daemon, CLI and GUI, and 32-bit with just the
# injected libraries, which 32-bit games -- including Windows titles under Proton,
# where DXVK produces 32-bit Vulkan -- need in /usr/lib32.
#
# Both builds pass -DVOCEM_ENABLE_BY_DEFAULT=ON: an installed package is expected to
# work with nothing to switch on. That means the Vulkan layer manifest carries only
# disable_environment, and the OpenGL shim is preloaded session-wide through
# environment.d, since OpenGL has no layer mechanism. Set VOCEM_DISABLE=1 to turn the
# overlay off for a single process.

pkgname=vocem-overlay
# The newest release that has a tag, and nothing else: source= below fetches
# #tag=v$pkgver, so a number without a tag behind it makes this file unbuildable
# for the stranger it exists for. It therefore stays one release behind while the
# next one is being written, and moves when the owner tags. PKGBUILD.local, which
# builds the working tree, carries the release being written instead.
# tests/version_agrees.cmake holds each of the two to its own rule.
pkgver=0.1.10
pkgrel=1
pkgdesc="Discord voice overlay drawn inside the game, through a Vulkan layer and an OpenGL hook"
arch=('x86_64')
url="https://github.com/ales-drnz/vocem-overlay"
# BSD-3-Clause for the project. MIT for Dear ImGui, compiled into every shipped
# library, and nlohmann/json, compiled into the daemon; Wuffs is dual-licensed and
# taken under MIT too. OFL-1.1-no-RFN for the emoji bank (a Modified Version of
# Noto Color Emoji, common/emoji/README.md), Inter and Noto Emoji;
# OFL-1.1-RFN for the Noto Sans JP subset, whose own text reserves the name
# 'Source'. Every one of those texts ships: entry 50 is what a derived artefact
# without its licence costs, and entry 76 is what shipping it from only one of
# the two PKGBUILDs cost.
license=('BSD-3-Clause' 'MIT' 'OFL-1.1-no-RFN' 'OFL-1.1-RFN')
depends=(
    'qt6-base'
    'qt6-declarative'
    # The window's own icons are SVG, loaded through QIcon, which needs Qt's
    # SVG image-format plugin. On a Plasma machine it arrives as a dependency
    # of the desktop style; on any other it did not, and the About page drew
    # an empty square where the icon goes -- the defect tray_icon_choice was
    # written against, back through the package's dependency list.
    'qt6-svg'
    'curl'
    'hicolor-icon-theme'
    # The settings window resolves a font family to the files the overlay opens:
    # a game may not ask fontconfig anything, so the window has to hand it paths.
    'fontconfig'
    # The 32-bit half is not optional: a Windows game under Proton is often a
    # 32-bit binary, and this package installs libraries under /usr/lib32 that the
    # session preloads into every one of them -- and a preloaded object that fails
    # to load makes ld.so print "cannot be preloaded: ignored" to the stderr of
    # every process that starts. Since 0.1.11 the injected libraries carry their
    # C++ runtime inside, -static-libstdc++ and -static-libgcc, so at 32 bits they
    # NEED libc.so.6, libm.so.6 and ld-linux.so.2 and nothing else, readelf -d on
    # build32 says: lib32-glibc, where this line said lib32-gcc-libs while they
    # NEEDed libstdc++.so.6 and libgcc_s.so.1.
    'lib32-glibc'
)
    # lib32-glibc is NOT repeated here. PKGBUILD(5) defines makedepends as
    # what a package needs "to build but are not needed at runtime", and it is
    # needed at runtime -- which is why it is in depends. makepkg installs
    # depends and makedepends alike before building (Arch package guidelines,
    # "Makepkg duties"), so depends alone already puts it there. namcap called
    # the repetition redundant and it was right.
makedepends=(
    'cmake'
    'ninja'
    'git'
    'vulkan-headers'
)
# The Vulkan loaders are not dependencies: nothing this package ships NEEDs or
# dlopens libvulkan.so.1 (readelf on 0.1.10-7, both widths). The layer is
# loaded BY the loader, which every Vulkan game already brings, so they are
# listed for what they do for it rather than as something it links. They sat
# in depends=() until 0.1.11, under a comment that was true of lib32-gcc-libs
# alone, and namcap reported both (tests/package_depends_needed.cmake).
optdepends=(
    'qqc2-desktop-style: native appearance on KDE Plasma'
    'vulkan-icd-loader: the loader that puts the overlay layer into 64-bit Vulkan games'
    'lib32-vulkan-icd-loader: the same for 32-bit Vulkan games, DXVK under Proton among them'
)
# No debug package: with CMAKE_BUILD_TYPE=None nothing is compiled with -g,
# so what makepkg would split out is empty. PKGBUILD.local has always said
# this and this file did not -- the two must not drift (entry 76).
options=('!debug')
# Dear ImGui is a submodule, and makepkg's git source does not fetch submodules.
# The comment here used to say they "have to come along" while nothing made them:
# a clone of this repository without them fails to configure. So imgui is a source
# of its own, pinned to the tag the submodule points at, and prepare() points the
# submodule at the copy makepkg already downloaded. Keep the tag in step with
# `git -C third_party/imgui describe --tags`.
source=("git+$url.git#tag=v$pkgver"
        "imgui::git+https://github.com/ocornut/imgui.git#tag=v1.91.9")
sha256sums=('SKIP'
            'SKIP')

# packaging/ is also where the defective exemplars live (EXEMPLARS.md), and they
# cannot be rebuilt. This file and PKGBUILD.local both start their numbering at
# pkgrel 1, so building the tag's recipe here for a release that already has a
# local 0.1.x-1 would write straight over it: at 0.1.10 the tag recipe's
# vocem-overlay-0.1.10-1 was the exemplar of entries 144/145, and 0.1.8-1 and
# 0.1.9-1 were in the same position. A package this build would replace is
# refused when EXEMPLARS.md lists its version; raise pkgrel, or set PKGDEST.
_refuse_to_replace_an_exemplar() {
    local table="$startdir/EXEMPLARS.md" dest="${PKGDEST:-$startdir}" existing
    [[ -f $table ]] || return 0
    for existing in "$dest/$pkgname-$pkgver-$pkgrel-"*.pkg.tar.*; do
        [[ -e $existing ]] || continue
        if grep -qE "^\| ${pkgver//./\\.}-([^|]*-)?${pkgrel}[ ,|]" "$table"; then
            error "%s is a defective exemplar (EXEMPLARS.md) and would be replaced" \
                "${existing##*/}"
            return 1
        fi
    done
}

prepare() {
    cd "$srcdir/$pkgname"
    git submodule init
    git config submodule.third_party/imgui.url "$srcdir/imgui"
    # protocol.file is refused by default since CVE-2022-39253; this one is our
    # own download directory, not a remote the source list did not name.
    git -c protocol.file.allow=always submodule update
}

build() {
    _refuse_to_replace_an_exemplar || return 1
    cd "$srcdir/$pkgname"

    # 64-bit: everything.
    # CMAKE_BUILD_TYPE=None, and NDEBUG put back by hand.
    #
    # A build type appends its own flags AFTER $CXXFLAGS, so it decides the
    # optimisation level whatever the machine's makepkg.conf asked for: measured
    # here, RelWithDebInfo's -O2 landed after this machine's -O3 and won. The
    # Arch CMake guidelines call that out and name None as the type that appends
    # nothing -- and it has to be passed explicitly, because CMakeLists.txt
    # forces RelWithDebInfo when it is left unset, which is the very case those
    # guidelines warn about.
    #
    # NDEBUG is not part of that trade and is added back on its own. It is what
    # compiles out assert(), and ImGui's IM_ASSERT *is* assert() (imgui.h:91):
    # 387 of them across the two ImGui units that go into the injected
    # libraries, every one an abort() in somebody's game if it ever fires.
    # Rule 7 says a game must never lose its stability to this overlay, so the
    # asserts stay compiled out no matter what build type is in use. It also
    # answers the caveat the same guidelines attach to None -- the $srcdir
    # references they warn about are "caused by the missing NDEBUG definition".
    # No tests in a package build (PKGBUILD.local has said so since it
    # existed; this file did not, and built fifty-odd test executables plus
    # their -m32 twins and a probe into ~/.steam for every stranger -- entry
    # 76's drift, found by diffing the two files).
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_CXX_FLAGS="$CXXFLAGS -DNDEBUG" \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DVOCEM_ENABLE_BY_DEFAULT=ON \
        -DVOCEM_BUILD_TESTS=OFF
    cmake --build build

    # 32-bit: injected libraries only. The daemon never enters a game process, so
    # there is nothing to gain from building it twice.
    # The flags below ADD to $CXXFLAGS and $LDFLAGS rather than replacing them.
    # CMake seeds CMAKE_CXX_FLAGS and CMAKE_SHARED_LINKER_FLAGS from makepkg's
    # environment, and passing -D...FLAGS="-m32" replaced that seed: the 32-bit
    # half shipped from the first release to 0.1.3 with no _FORTIFY_SOURCE and no
    # full RELRO, while the 64-bit half beside it in the same package had both
    # (measured on 0.1.3-1: 7 _chk symbols and BIND_NOW against 0 and none). It
    # is the half preloaded into every 32-bit process of the session, so it is
    # the half where hardening is worth most. The shim's constraints survive --
    # its target re-applies -fno-exceptions after these -- and they are checked
    # on the packaged artifact, not here.
    # ...and the layout is stated rather than inferred. CMakeLists.txt picks
    # lib32 from CMAKE_SIZEOF_VOID_P, which CMake works out by probing the
    # compiler -- and with -flto in the flags above it cannot: the probe object
    # is GIMPLE, the value never reaches the cache, the test is false and the
    # 32-bit libraries install over the 64-bit ones in /usr/lib. Measured, on a
    # package built exactly once that way: /usr/lib/libvocem_gl.so came out
    # i386. An installed package like that puts a 32-bit object in the preload
    # of every 64-bit process in the session. The flatpak manifest has always
    # said its libdir outright for the same reason; so does this now.
    cmake -S . -B build32 -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DVOCEM_BUILD_HOST_TOOLS=OFF \
        -DVOCEM_ENABLE_BY_DEFAULT=ON \
        -DCMAKE_CXX_FLAGS="$CXXFLAGS -DNDEBUG -m32" \
        -DCMAKE_SHARED_LINKER_FLAGS="$LDFLAGS -m32" \
        -DCMAKE_INSTALL_LIBDIR=lib32 \
        -DVOCEM_LIBDIR_OVERRIDDEN=ON
    cmake --build build32
}

package() {
    cd "$srcdir/$pkgname"

    DESTDIR="$pkgdir" cmake --install build
    DESTDIR="$pkgdir" cmake --install build32

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    # OFL texts for the emoji bank and the embedded font subsets (all Modified
    # Versions under the OFL 1.1; see common/emoji/README.md and
    # third_party/fonts/README.md). These lived only in PKGBUILD.local, so the
    # package a stranger would build was the one shipping derived font data with
    # no licence beside it.
    install -Dm644 common/emoji/OFL-NotoColorEmoji.txt \
        "$pkgdir/usr/share/licenses/$pkgname/OFL-NotoColorEmoji.txt"
    install -Dm644 third_party/fonts/OFL.txt \
        "$pkgdir/usr/share/licenses/$pkgname/OFL-Inter.txt"
    install -Dm644 third_party/fonts/OFL-NotoEmoji.txt \
        "$pkgdir/usr/share/licenses/$pkgname/OFL-NotoEmoji.txt"
    install -Dm644 third_party/fonts/OFL-NotoSansJP.txt \
        "$pkgdir/usr/share/licenses/$pkgname/OFL-NotoSansJP.txt"
    install -Dm644 third_party/fonts/OFL-NotoSansMath.txt \
        "$pkgdir/usr/share/licenses/$pkgname/OFL-NotoSansMath.txt"
    install -Dm644 third_party/fonts/OFL-NotoSansSymbols.txt \
        "$pkgdir/usr/share/licenses/$pkgname/OFL-NotoSansSymbols.txt"
    install -Dm644 third_party/fonts/OFL-NotoSansSymbols2.txt \
        "$pkgdir/usr/share/licenses/$pkgname/OFL-NotoSansSymbols2.txt"
    # Dear ImGui, compiled into both injected libraries, and nlohmann/json,
    # compiled into the daemon: both MIT, both requiring their notice to travel
    # with a binary distribution.
    install -Dm644 third_party/imgui/LICENSE.txt \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE-imgui.txt"
    install -Dm644 third_party/nlohmann/LICENSE.MIT \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE-nlohmann-json.txt"
    # Wuffs, the PNG decoder compiled into vocemd: dual MIT / Apache 2.0, taken
    # under MIT (third_party/wuffs/README.md), its text shipped for attribution.
    install -Dm644 third_party/wuffs/LICENSE \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE-wuffs.txt"
}

