#
# Builds the package from the working tree instead of a git tag, for testing changes
# before they are released. Use it exactly like the normal PKGBUILD:
#
#     cd packaging && makepkg -p PKGBUILD.local -fi
#
# Going through pacman rather than `cmake --install` is deliberate: the files are
# tracked, `pacman -Qo` can say where each one came from, and removing it later is
# `pacman -Rns vocem-overlay` rather than hunting for leftovers by hand.

pkgname=vocem-overlay
pkgver=0.1.9
# Reset with 0.1.0: releases are numbered from here (0.1.1, 0.1.2), and pkgrel
# rises only to rebuild the same release. The old monotonic counter reached 67.
#
# This one is ahead of the tag on purpose: this file builds the working tree, so
# while a release is being written it carries that release's number and its
# pkgrel rises with each test build. The tag-built PKGBUILD moves to the same
# number when the tag exists.
#
# pkgver is not free to be whatever this file says, and it is not free to equal
# the other PKGBUILD either: it is the release being written, which is what
# CMakeLists.txt states. tests/version_agrees.cmake holds the two equal, and
# holds the tag-built PKGBUILD to the newest tag instead.
pkgrel=1
pkgdesc="Discord voice overlay drawn inside the game (built from the working tree)"
arch=('x86_64')
url="https://github.com/ales-drnz/vocem-overlay"
# See PKGBUILD for what each of these covers; the two must not drift.
license=('BSD-3-Clause' 'MIT' 'OFL-1.1-no-RFN' 'OFL-1.1-RFN')
depends=(
    'vulkan-icd-loader'
    'qt6-base'
    'qt6-declarative'
    # See PKGBUILD.
    'qt6-svg'
    'curl'
    'hicolor-icon-theme'
    # The settings window resolves a font family to the files the overlay opens:
    # a game may not ask fontconfig anything, so the window has to hand it paths.
    'fontconfig'
    # The 32-bit half is not optional: a Windows game under Proton is often a
    # 32-bit binary, and this package installs libraries under /usr/lib32 that the
    # session preloads into every one of them. Without these they fail to load --
    # and a preloaded object that fails to load makes ld.so print
    # "cannot be preloaded: ignored" to the stderr of every process that starts.
    # They were in makedepends only, which builds the files and then ships them
    # with nothing declaring what they need to run.
    'lib32-gcc-libs'
    'lib32-vulkan-icd-loader'
)
    # The two lib32 packages are NOT repeated here. PKGBUILD(5) defines
    # makedepends as what a package needs "to build but are not needed at
    # runtime", and these are needed at runtime -- which is why they are in
    # depends. makepkg installs depends and makedepends alike before building
    # (Arch package guidelines, "Makepkg duties"), so depends alone already puts
    # them there. namcap called the pair redundant and it was right.
makedepends=(
    'cmake'
    'ninja'
    'vulkan-headers'
)
optdepends=(
    'qqc2-desktop-style: native appearance on KDE Plasma'
)
options=('!debug')

_root="$startdir/.."

build() {
    # 64-bit: everything, with automatic coverage enabled as in a real install.
    # CMAKE_BUILD_TYPE=None, and NDEBUG put back by hand.
    #
    # A build type appends its own flags AFTER $CXXFLAGS, so it decides the
    # optimisation level whatever the machine's makepkg.conf asked for: measured
    # here, RelWithDebInfo's -O2 landed after this machine's -O3 and won. The
    # Arch CMake guidelines call that out and name None as the type that appends
    # nothing -- and it has to be passed explicitly, because CMakeLists.txt
    # forces RelWithDebInfo when it is left unset, which is the very case those
    # guidelines warn about.
    #
    # NDEBUG is not part of that trade and is added back on its own. It is what
    # compiles out assert(), and ImGui's IM_ASSERT *is* assert() (imgui.h:91):
    # 387 of them across the two ImGui units that go into the injected
    # libraries, every one an abort() in somebody's game if it ever fires.
    # Rule 7 says a game must never lose its stability to this overlay, so the
    # asserts stay compiled out no matter what build type is in use. It also
    # answers the caveat the same guidelines attach to None -- the $srcdir
    # references they warn about are "caused by the missing NDEBUG definition".
    cmake -S "$_root" -B "$srcdir/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_CXX_FLAGS="$CXXFLAGS -DNDEBUG" \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DVOCEM_ENABLE_BY_DEFAULT=ON \
        -DVOCEM_BUILD_TESTS=OFF
    cmake --build "$srcdir/build"

    # 32-bit: only the injected libraries, for 32-bit titles under Proton.
    # The flags below ADD to $CXXFLAGS and $LDFLAGS rather than replacing them.
    # CMake seeds CMAKE_CXX_FLAGS and CMAKE_SHARED_LINKER_FLAGS from makepkg's
    # environment, and passing -D...FLAGS="-m32" replaced that seed: the 32-bit
    # half shipped from the first release to 0.1.3 with no _FORTIFY_SOURCE and no
    # full RELRO, while the 64-bit half beside it in the same package had both
    # (measured on 0.1.3-1: 7 _chk symbols and BIND_NOW against 0 and none). It
    # is the half preloaded into every 32-bit process of the session, so it is
    # the half where hardening is worth most. The shim's constraints survive --
    # its target re-applies -fno-exceptions after these -- and they are checked
    # on the packaged artifact, not here.
    # ...and the layout is stated rather than inferred. CMakeLists.txt picks
    # lib32 from CMAKE_SIZEOF_VOID_P, which CMake works out by probing the
    # compiler -- and with -flto in the flags above it cannot: the probe object
    # is GIMPLE, the value never reaches the cache, the test is false and the
    # 32-bit libraries install over the 64-bit ones in /usr/lib. Measured, on a
    # package built exactly once that way: /usr/lib/libvocem_gl.so came out
    # i386. An installed package like that puts a 32-bit object in the preload
    # of every 64-bit process in the session. The flatpak manifest has always
    # said its libdir outright for the same reason; so does this now.
    cmake -S "$_root" -B "$srcdir/build32" -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DVOCEM_BUILD_HOST_TOOLS=OFF \
        -DVOCEM_ENABLE_BY_DEFAULT=ON \
        -DCMAKE_CXX_FLAGS="$CXXFLAGS -DNDEBUG -m32" \
        -DCMAKE_SHARED_LINKER_FLAGS="$LDFLAGS -m32" \
        -DCMAKE_INSTALL_LIBDIR=lib32 \
        -DVOCEM_LIBDIR_OVERRIDDEN=ON
    cmake --build "$srcdir/build32"
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
    DESTDIR="$pkgdir" cmake --install "$srcdir/build32"
    install -Dm644 "$_root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    # OFL texts for the emoji bank and the embedded font subsets (all Modified
    # Versions under the OFL 1.1; see common/emoji/README.md and
    # third_party/fonts/README.md).
    install -Dm644 "$_root/common/emoji/OFL-NotoColorEmoji.txt" \
        "$pkgdir/usr/share/licenses/$pkgname/OFL-NotoColorEmoji.txt"
    install -Dm644 "$_root/third_party/fonts/OFL.txt" \
        "$pkgdir/usr/share/licenses/$pkgname/OFL-Inter.txt"
    install -Dm644 "$_root/third_party/fonts/OFL-NotoEmoji.txt" \
        "$pkgdir/usr/share/licenses/$pkgname/OFL-NotoEmoji.txt"
    install -Dm644 "$_root/third_party/fonts/OFL-NotoSansJP.txt" \
        "$pkgdir/usr/share/licenses/$pkgname/OFL-NotoSansJP.txt"
    install -Dm644 "$_root/third_party/fonts/OFL-NotoSansMath.txt" \
        "$pkgdir/usr/share/licenses/$pkgname/OFL-NotoSansMath.txt"
    install -Dm644 "$_root/third_party/fonts/OFL-NotoSansSymbols.txt" \
        "$pkgdir/usr/share/licenses/$pkgname/OFL-NotoSansSymbols.txt"
    install -Dm644 "$_root/third_party/fonts/OFL-NotoSansSymbols2.txt" \
        "$pkgdir/usr/share/licenses/$pkgname/OFL-NotoSansSymbols2.txt"
    # Dear ImGui, compiled into both injected libraries, and nlohmann/json,
    # compiled into the daemon: both MIT, both requiring their notice to travel
    # with a binary distribution.
    install -Dm644 "$_root/third_party/imgui/LICENSE.txt" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE-imgui.txt"
    install -Dm644 "$_root/third_party/nlohmann/LICENSE.MIT" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE-nlohmann-json.txt"
    # Wuffs, the PNG decoder compiled into vocemd: dual MIT / Apache 2.0, taken
    # under MIT (third_party/wuffs/README.md), its text shipped for attribution.
    install -Dm644 "$_root/third_party/wuffs/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE-wuffs.txt"
}

# vim:set ts=4 sw=4 et:
